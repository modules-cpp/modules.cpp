#!/bin/sh
# shell script to run the sketch tool through the shell tool instead of the
# system shell directly; see sketch.sh for the plain version
#

# Sort, compare, and match bytes, and keep tool messages untranslated,
# whatever the caller's locale.
LC_ALL=C
export LC_ALL

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MM_BUILD="$script_dir/out"
echo "Run sketch"
echo

# mm.shell is installed by the configured full build. Without it, use the
# plain launcher, which reports the missing tool precisely.
if [ ! -x "${MM_BUILD}/bin/shell" ]; then
    exec sh "$script_dir/sketch.sh" "$@"
fi

if [ "${MM_SHELL_LEGACY:-0}" = 1 ]; then
    exec "${MM_BUILD}/bin/shell" --legacy-sh --run "$script_dir/sketch.sh" -- "$@"
fi
exec "${MM_BUILD}/bin/shell" --run "$script_dir/sketch.sh" -- "$@"
