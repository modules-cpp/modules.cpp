#!/bin/sh
# shell script to run clean.sh through the shell tool instead of the system
# shell directly; see clean.sh for the plain version
#

MM_BUILD="out"
echo "Run clean"
echo

if [ ! -x "${MM_BUILD}/bin/shell" ]; then
    exec sh clean.sh "$@"
fi

if [ "${MM_SHELL_LEGACY:-0}" = 1 ]; then
    exec "${MM_BUILD}/bin/shell" --legacy-sh --run clean.sh -- "$@"
fi
exec "${MM_BUILD}/bin/shell" --run clean.sh -- "$@"
