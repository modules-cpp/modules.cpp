#!/bin/sh
# shell script to run bootstrap.sh through the shell tool instead of the
# system shell directly; see bootstrap.sh for the plain version
#

MM_BUILD="out"
echo "Run bootstrap"
echo

if [ ! -x "${MM_BUILD}/bin/shell" ]; then
    exec sh bootstrap.sh "$@"
fi

if [ "${MM_SHELL_LEGACY:-0}" = 1 ]; then
    exec "${MM_BUILD}/bin/shell" --legacy-sh --run bootstrap.sh -- "$@"
fi
exec "${MM_BUILD}/bin/shell" --run bootstrap.sh -- "$@"
