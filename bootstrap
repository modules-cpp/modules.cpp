#
# shell script to run bootstrap.sh through the shell tool instead of the
# system shell directly; see bootstrap.sh for the plain version
#

MM_BUILD="out"
echo "Run bootstrap"
echo

cmd="sh bootstrap.sh"
for arg in "$@"; do
    cmd="$cmd '$(printf '%s' "$arg" | sed "s/'/'\\\\''/g")'"
done

${MM_BUILD}/bin/shell "$cmd"
