#!/bin/sh
# shell script to run build.sh through the shell tool instead of the system
# shell directly; see build.sh for the plain version
#

MM_BUILD="out"
echo "Run build"
echo

# Bootstrap installs the build tool but deliberately does not build mm.shell.
# Keep the first configured build usable through the plain launcher.
if [ ! -x "${MM_BUILD}/bin/shell" ]; then
    exec sh build.sh "$@"
fi

if [ "${MM_SHELL_LEGACY:-0}" = 1 ]; then
    exec "${MM_BUILD}/bin/shell" --legacy-sh --run build.sh -- "$@"
fi
exec "${MM_BUILD}/bin/shell" --run build.sh -- "$@"
