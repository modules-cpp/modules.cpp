#!/bin/sh
# shell script to run the mdy documentation tool through the shell tool
# instead of the system shell directly; see document.sh for the plain
# version
#

# Sort, compare, and match bytes, and keep tool messages untranslated,
# whatever the caller's locale.
LC_ALL=C
export LC_ALL

MM_BUILD="out"
echo "Run document"
echo

# mm.shell is installed by the configured full build. Without it, use the
# plain launcher, which reports the missing tool precisely.
if [ ! -x "${MM_BUILD}/bin/shell" ]; then
    exec sh document.sh "$@"
fi

if [ "${MM_SHELL_LEGACY:-0}" = 1 ]; then
    exec "${MM_BUILD}/bin/shell" --legacy-sh --run document.sh -- "$@"
fi
exec "${MM_BUILD}/bin/shell" --run document.sh -- "$@"
