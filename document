#
# shell script to run the mdy documentation tool through the shell tool
# instead of the system shell directly; see document.sh for the plain
# version
#

MM_BUILD="out"
echo "Run document"
echo

# mm.shell is installed by the configured full build. Without it, use the
# plain launcher, which reports the missing tool precisely.
if [ ! -x "${MM_BUILD}/bin/shell" ]; then
    exec sh document.sh "$@"
fi

cmd="sh document.sh"
# Each argument is single-quoted so it survives the second /bin/sh the
# shell tool runs the command through: without that, spaces and shell
# metacharacters in an argument would be re-interpreted there.
for arg in "$@"; do
    cmd="$cmd '$(printf '%s' "$arg" | sed "s/'/'\\\\''/g")'"
done

${MM_BUILD}/bin/shell "$cmd"
