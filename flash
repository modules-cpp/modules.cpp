#!/bin/sh
# Run flash.sh through the project's shell tool.

# Sort, compare, and match bytes, and keep tool messages untranslated,
# whatever the caller's locale.
LC_ALL=C
export LC_ALL

MM_BUILD="out"
echo "Flash application"
echo

if [ ! -x "${MM_BUILD}/bin/shell" ]; then
    exec sh flash.sh "$@"
fi

if [ "${MM_SHELL_LEGACY:-0}" = 1 ]; then
    exec "${MM_BUILD}/bin/shell" --legacy-sh --run flash.sh -- "$@"
fi
exec "${MM_BUILD}/bin/shell" --run flash.sh -- "$@"
