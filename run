#!/bin/sh
# Run run.sh through the project's shell tool.

MM_BUILD="out"
echo "Run application"
echo

# mm.shell is installed by the configured full build. Without it, use the
# plain launcher, which reports the missing tool precisely.
if [ ! -x "${MM_BUILD}/bin/shell" ]; then
    exec sh run.sh "$@"
fi

if [ "${MM_SHELL_LEGACY:-0}" = 1 ]; then
    exec "${MM_BUILD}/bin/shell" --legacy-sh --run run.sh -- "$@"
fi
exec "${MM_BUILD}/bin/shell" --run run.sh -- "$@"
