#
# shell script to run the model tool through the shell tool instead of the
# system shell directly; see model.sh for the plain version
#

MM_BUILD="out"
echo "Run model"
echo

cmd="${MM_BUILD}/bin/model"
for arg in "$@"; do
    cmd="$cmd '$(printf '%s' "$arg" | sed "s/'/'\\\\''/g")'"
done

${MM_BUILD}/bin/shell "$cmd"
