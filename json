#!/bin/sh
# shell script to run the json tool through the shell tool instead of the
# system shell directly; see json.sh for the plain version
#

MM_BUILD="out"

# No banner: the tool writes documents to stdout, and a formatter that
# announces itself is not one a script can pipe.

# mm.shell is installed by the configured full build. Without it, use the
# plain launcher, which reports the missing tool precisely.
if [ ! -x "${MM_BUILD}/bin/shell" ]; then
    exec sh json.sh "$@"
fi

if [ "${MM_SHELL_LEGACY:-0}" = 1 ]; then
    exec "${MM_BUILD}/bin/shell" --legacy-sh --run json.sh -- "$@"
fi
exec "${MM_BUILD}/bin/shell" --run json.sh -- "$@"
