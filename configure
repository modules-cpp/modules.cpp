#!/bin/sh
# shell script to run the configure tool through the shell tool instead of the
# system shell directly; see configure.sh for the plain version
#

# Sort, compare, and match bytes, and keep tool messages untranslated,
# whatever the caller's locale.
LC_ALL=C
export LC_ALL

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MM_BUILD="$script_dir/out"
echo "Run configure"
echo

# mm.shell is installed by the configured full build. On a fresh checkout,
# configure1 must run before that build exists, so use the plain launcher.
if [ ! -x "${MM_BUILD}/bin/shell" ]; then
    exec sh "$script_dir/configure.sh" "$@"
fi

if [ "${MM_SHELL_LEGACY:-0}" = 1 ]; then
    exec "${MM_BUILD}/bin/shell" --legacy-sh --run "$script_dir/configure.sh" -- "$@"
fi
exec "${MM_BUILD}/bin/shell" --run "$script_dir/configure.sh" -- "$@"
